# Server configuration. Keep real values in ignored .env.local.
# Local setup can generate the operator/session secrets: npm run setup:local
PORT=3000
TEST_BASE_URL=http://127.0.0.1:3000
LAUNCHLANE_ORIGIN=http://127.0.0.1:3000

# Liara PaaS. Never prefix a secret with NEXT_PUBLIC_.
LIARA_API_BASE_URL=https://api.liara.ir
LIARA_API_TOKEN=
LIARA_TEAM_ID=

# BoxAPI only. gpt-6-luna/none passed a small non-streaming tool/result/terminal smoke.
# Incident diagnosis, other models, remaining quota and actual account billing are unverified.
MODEL_BASE_URL=https://ai.boxapi.ir/ai/v1
MODEL_API_KEY=
MODEL_ID=
MODEL_REASONING_EFFORT=none

# Operator-local, single-process MVP. Resolve and validate these on the server.
LAUNCHLANE_WORKSPACE_ROOT=
LAUNCHLANE_STATE_DIR=.data
LAUNCHLANE_APP_ALLOWLIST=
# Long random operator login token; distinct from the session signing secret.
LAUNCHLANE_OPERATOR_TOKEN=
LAUNCHLANE_SESSION_SECRET=

# Execution gates: a configuration flag is never a substitute for per-action approval.
LAUNCHLANE_ENABLE_MUTATIONS=false
LAUNCHLANE_ENABLE_LIVE_MODEL=false
LAUNCHLANE_MAX_MODEL_CALLS=8
LAUNCHLANE_MAX_TOOL_CALLS=12
LAUNCHLANE_RUN_TIMEOUT_MS=120000
LAUNCHLANE_MODEL_OUTPUT_TOKENS=1024
