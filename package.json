{
  "name": "launchlane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A human-guided deployment and service reliability assistant.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:hosted": "node --env-file-if-exists=.env.local scripts/start-hosted.mjs",
    "lint": "biome lint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/bootstrap.test.mjs",
    "test:domain": "node --test --test-concurrency=1 tests/domain/*.test.ts tests/domain/*.test.mjs",
    "test:sandbox": "node scripts/test-sandbox.mjs && node --test tests/sandbox/*.test.ts",
    "test:build-sandbox": "node scripts/test-build-sandbox.mjs && node --test tests/sandbox/environment-build.test.ts",
    "test:http": "node --test tests/http/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs && node scripts/test-deployment-browser.mjs && node scripts/test-restart-browser.mjs && node scripts/test-domain-browser.mjs && node scripts/test-guided-browser.mjs && node scripts/test-destination-browser.mjs && node scripts/test-studio-browser.mjs && npm run test:interactions && npm run test:mobile && npm run test:chat && npm run test:platforms && npm run test:publication-expiry",
    "test:studio": "node scripts/test-studio-browser.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "review:source-fixtures": "node --env-file-if-exists=.env.local scripts/review-source-fixtures.mjs",
    "setup:github": "powershell -NoProfile -File scripts/setup-github.ps1",
    "smoke:model": "node scripts/smoke-model.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:domain && npm test",
    "test:interactions": "node scripts/test-folder-browser.mjs && node scripts/test-motion-browser.mjs",
    "setup:mcp": "node scripts/setup-mcp.mjs",
    "smoke:mcp:codex": "node scripts/smoke-mcp-codex.mjs",
    "test:mobile": "node scripts/test-mobile-browser.mjs",
    "test:chat": "node scripts/test-chat-browser.mjs",
    "test:platforms": "node scripts/test-platform-browser.mjs",
    "test:networks": "node scripts/test-network-browser.mjs",
    "test:destination-plans": "node scripts/test-destination-plans-browser.mjs",
    "test:projects": "node scripts/test-project-library-browser.mjs",
    "test:login": "node scripts/test-liara-login-browser.mjs",
    "test:static": "node scripts/test-static-browser.mjs",
    "test:publication-expiry": "node scripts/test-agent-expiry-browser.mjs",
    "test:storage": "node scripts/test-disk-browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "ignore": "7.0.5",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "tar-stream": "3.2.2",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.8.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  }
}
