{
  "name": "launchlane-fixture/laravel-orders",
  "description": "Public controlled Laravel API runtime fixture",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.3",
    "psr/log": "3.0.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Invoice\\": "src/",
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "InvoiceTests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  }
}
